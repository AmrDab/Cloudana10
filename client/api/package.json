{
  "name": "@cloudana/client-api",
  "version": "1.0.0",
  "type": "module",
  "description": "Cloudana API \u2014 one Hono app on two runtimes: the Cloudflare Worker (api.cloudana.io: D1, KV, R2, relay binding) and a Node runtime with embedded SQLite (local development, tests, independent operators)",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "templates": "tsx scripts/seed-akash-templates-to-d1.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/swagger-ui": "0.4.1",
    "@hono/zod-openapi": "0.18.4",
    "dotenv": "^16.4.5",
    "hono": "^4.6.12",
    "stripe": "^20.4.1",
    "viem": "^2.45.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260525.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.20.5",
    "typescript": "^5.7.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
