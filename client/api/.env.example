PORT=7002
APP_URL=http://localhost:3000
# Orchestrator state lives in embedded SQLite (Node 24 built-in) — no external DB.
# Use a persistent volume path in production (e.g. on Akash).
CLOUDANA_DB_PATH=./data/cloudana.sqlite

# Optional shared secret for internal/service callers (e.g. seeding PoUW jobs
# without a wallet). Leave unset to disable that path.
INTERNAL_API_KEY=your_internal_api_key_min_16_chars

# Orchestrator
ORCHESTRATOR_EVENT_DRIVEN_ENABLED=true
ORCHESTRATOR_EVENT_DEBOUNCE_MS=2000
ORCHESTRATOR_PRIVATE_KEY=your_orchestrator_private_key
ORCHESTRATOR_RPC_TRANSPORT=websocket
ORCHESTRATOR_CHAIN_RPC_URL=https://base-sepolia.drpc.org
ORCHESTRATOR_CHAIN_WSS_URL=wss://base-sepolia.g.alchemy.com/v2/your_alchemy_key

# POUW Mining
POUW_MIN_DIFFICULTY=8
POUW_VERIFIER_CONTRACT_ADDRESS=0xc15c61E35D6d73dEf14460a1C7010fd169eD2e7F
POUW_MINING_POOL_WORKLOAD_ID=999
MINING_REWARDS_ENABLED=true
REWARD_CONTRACT_ADDRESS=0x427830A20C4752eb30C47e0d2572A457ebF4A8AD
CLD_TOKEN_ADDRESS=your_cld_token_contract_address
CLD_TREASURY_ADDRESS=your_cld_treasury_contract_address
# CLD credits charged for a paid matrix job at n=64; scales with (n/64)^1.5.
POUW_JOB_PRICE_CLD=1
# How many times to retry an on-chain certificate record before giving up.
POUW_CHAIN_RECORD_MAX_ATTEMPTS=5
# TTL for a miner's claim on a job before it becomes claimable again (ms).
POUW_JOB_CLAIM_TTL_MS=300000
# Share of the reward paid to a filler (unbacked) certificate.
POUW_FILLER_REWARD_FRACTION=0.1
# Max filler certificates rewarded per provider per day.
POUW_FILLER_DAILY_CERT_CAP=20
CHAIN_NETWORK=baseSepolia
CHAIN_ID=84532
RPC_URL=https://base-sepolia.drpc.org

# Orchestrator loops
ORCHESTRATOR_POLL_ENABLED=false
ORCHESTRATOR_POLL_INTERVAL_MS=60000
ORCHESTRATOR_DEPLOY_TIMEOUT_MS=15000
ORCHESTRATOR_TERMINATE_TIMEOUT_MS=15000
ORCHESTRATOR_WEBSOCKET_RETRY_COUNT=3
ORCHESTRATOR_WEBSOCKET_RETRY_DELAY=3000
WORKLOAD_STATUS_POLLING_ENABLED=true
WORKLOAD_STATUS_POLL_INTERVAL_MS=15000
WORKLOAD_STATUS_CACHE_TTL_MS=60000

# Payments (Stripe) — required only if the Node orchestrator handles payments too
CLD_USD_RATE=100
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# JWT Auth
JWT_SECRET=your_jwt_secret_here_min_32_chars

# Akash Bridge (bootstrap compute — piggybacks on Akash Network providers)
AKASH_BRIDGE_ENABLED=false
AKASH_MNEMONIC=your_akash_wallet_mnemonic_24_words
AKASH_RPC_URL=https://rpc.akashnet.net:443
AKASH_REST_URL=https://api.akashnet.net
AKASH_LCD_URL=https://rest.cosmos.directory/akash
AKASH_CHAIN_ID=akashnet-2
AKASH_NETWORK=mainnet
AKASH_GAS_PRICE=0.025uakt
AKASH_DEPOSIT_UAKT=500000
AKASH_BID_TIMEOUT_MS=120000
AKASH_NODE_STATUS_CHECK=
AKASH_VERSION=v1.0.0

# Provider build toolchain (used by build-provider/hardware-scan routes, Node only)
HELM_VERSION=your_helm_version
INGRESS_NGINX_VERSION=4.11.3
PROVIDER_SERVICES_VERSION=v0.10.1
PROVIDER_PRICE_SCRIPT_URL=https://raw.githubusercontent.com/akash-network/helm-charts/main/charts/akash-provider/scripts/price_script_generic.sh

# IPFS pinning (server-side only; never expose to the browser)
PINATA_JWT=your_pinata_jwt_token
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/
IPFS_GATEWAY=https://gateway.pinata.cloud

# ── v1 work pipeline (docs/BUILD_SPEC_V1.md) ── local defaults shown; prod: EPOCH_SECONDS=86400, VEST_B_SECONDS=604800, CLUSTER_N_MIN=3
DEV_MODE=false
EPOCH_SECONDS=120
VEST_B_SECONDS=120
SUBSIDY_RHO=0.25
CLUSTER_N_MIN=1
CLUSTER_S_CAP=0.5
PRICE_UCLD_PER_MMAC=1000
# Must never exceed the on-chain lane-B allowance for one epoch (local: ~0.304 CLD per 120 s).
EPOCH_SUBSIDY_BUDGET_UCLD=300000
# TREASURY_ADDRESS=0x...   (receives the 0.5% treasury lane)
NODE_ACTIVE_SECONDS=15
ASSIGNMENT_TTL_SECONDS=60
# CHAIN_RPC_URL=http://127.0.0.1:8545   (assignment seed = latest block hash)
