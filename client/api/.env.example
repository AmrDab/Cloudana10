# Cloudana API — environment for the Node runtime (src/index.ts) and `vitest`.
# The Cloudflare Worker gets the same names from wrangler.toml [vars] and `wrangler secret put`.
# src/config/env.ts is the source of truth for every variable and its default.

# ── Runtime ─────────────────────────────────────────────────────────────────
PORT=7002
APP_URL=http://localhost:3000
# Embedded SQLite (node:sqlite) for the Node runtime; the Worker uses D1.
CLOUDANA_DB_PATH=./data/cloudana.sqlite
# Run the Worker's cron duties on a 60 s timer (dead-node requeue, start timeouts, assignment, price, deposits).
NODE_CRON_ENABLED=true

# ── Auth / internal ─────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_min_32_chars
# Shared with the keeper and the gateway (x-internal-key): admin epochs, route lookups, admin stop.
INTERNAL_API_KEY=your_internal_api_key_min_16_chars

# ── Node instructions (docs/IMPL_SPEC_2026-10.md) ───────────────────────────
# secp256k1 private key that signs heartbeat instructions. NOT a chain key; never holds funds.
INSTRUCTION_SIGNING_KEY=
# Agents below this get no work (default: the version the API was built against).
# MIN_AGENT_VERSION=1.3.0
# Extra image regexes (comma-separated) allowed on fleet nodes besides the curated templates.
# IMAGE_ALLOWLIST=

# ── Relay (docs/V4_RELAY_CONTRACT.md) ───────────────────────────────────────
# Same value on cloudana-relay. Unset → no relay; nodes stay in legacy direct mode.
# RELAY_TICKET_SECRET=at_least_32_characters
RELAY_URL=wss://relay.cloudana.io/connect
RELAY_FRESH_SECONDS=45

# ── Chain (read-only; the API holds no chain key) ───────────────────────────
CHAIN_NETWORK=baseSepolia
CHAIN_ID=84532
# Assignment seed (latest block hash) and the deposit watcher. Local stack: http://127.0.0.1:8545
CHAIN_RPC_URL=https://sepolia.base.org
# v2 CloudanaSettlement; the Deposited watcher is inactive while unset.
# SETTLEMENT_ADDRESS=
# DEPOSIT_WATCHER_START_BLOCK=
DEPOSIT_CONFIRMATIONS=10

# ── Economics (docs/IMPL_SPEC_2026-10.md, docs/TOKENOMICS_USD_PRICING.md) ─────
# Reference rate (testnet: fixed). Prices are quoted in USD and settled in CLD.
USD_PER_CLD=0.1
PRICE_NUSD_PER_TMAC=1400
BASE_FEE_USD=0.0001
PRICE_CONTROLLER=on
# Testnet 3600 / 3600; mainnet 86400 / 604800. Changing EPOCH_SECONDS voids unsettled entries (lib/schema.ts).
EPOCH_SECONDS=3600
VEST_B_SECONDS=3600
SUBSIDY_RHO=0.04
EPOCH_SUBSIDY_BUDGET_UCLD=7300000
# Per-operator cluster gate. Single-node local dev: CLUSTER_N_MIN=1
CLUSTER_N_MIN=3
CLUSTER_S_CAP=0.5
NODE_ACTIVE_SECONDS=45
ASSIGNMENT_TTL_SECONDS=60

# ── Hosting (docs/V3_CONTRACT.md, docs/PRICES_USD.md) ───────────────────────
# User-content domain: https://{deploymentId}.{SITES_DOMAIN}
SITES_DOMAIN=cloudana.run
DEPLOY_PROBE_SECONDS=60
DEPLOY_PROBE_FAILS=3
# Assigned but never reported running within this → re-queued elsewhere; failed after DEPLOY_START_ATTEMPTS.
DEPLOY_START_TIMEOUT_SECONDS=3600
DEPLOY_START_TIMEOUT_STATIC_SECONDS=600
DEPLOY_START_ATTEMPTS=3
PRICE_HOSTING_USD_PER_HOUR=0.0014
PRICE_CPU_USD_PER_HOUR=0.01
PRICE_MEM_USD_PER_GB_HOUR=0.0012
PRICE_STORAGE_USD_PER_GB_HOUR=0.0001
PRICE_VOLUME_USD_PER_GB_HOUR=0.0001
PRICE_GPU_STANDARD_USD_PER_HOUR=0.3
PRICE_GPU_LARGE_USD_PER_HOUR=1.2
PRICE_GPU_H100_USD_PER_HOUR=2
INTERRUPTIBLE_DISCOUNT=0.5

# ── Storage phase 1 (docs/V4_STORAGE_PHASE1_CONTRACT.md) ────────────────────
# base64 of 32 random bytes. Unset → no provider copies (artifacts stay R2-only); DEV_MODE uses a fixed dev key.
# STORAGE_KEK=
STORAGE_COPIES=2
STORAGE_RETENTION_DAYS=30

# ── Credits / payments ──────────────────────────────────────────────────────
# DEV_MODE: unlimited test credits, loopback endpoints allowed. Never in production.
DEV_MODE=false
# Public testnet: 10 test CLD per wallet and per IP per day (no monetary value). Remove before CLD carries value.
TESTNET_CREDITS=false
# Cards are off; Stripe routes answer 503 unless this is true.
STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── IPFS pinning (server-side only; never expose to the browser) ─────────────
# PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/
IPFS_GATEWAY=https://gateway.pinata.cloud

# ── Node runtime behind a trusted proxy ─────────────────────────────────────
# Trust CF-Connecting-IP / X-Forwarded-For for client IPs (credit caps, a node's announced host).
TRUST_PROXY=false
