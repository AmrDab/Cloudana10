# Retired static pages → their successors (301 so old links and search results follow)
/landing.html            /        301
/browser-contribute      /lab     301
/browser-contribute.html /lab     301
/prototype-verify.html   /lab     301
# Agents up to 1.4.0 print /app/provide.html?node=…&code=… as the bind link: keep it landing on Provide (query kept).
/app/provide.html        /control/provide 301
/app/*                   /control/run 301
# No 404.html in the build: Cloudflare Pages then serves index.html for unknown paths (SPA mode),
# and the app renders its own 404 page.
