# Cloudana machine: keys only, no passwords. Ubuntu's sshd_config includes this file first, and the first value sshd
# reads for a keyword wins, so these override the distribution defaults below the Include.
#
# The login is root, by key only: root of the box, inside the gVisor sandbox (docs/TRUST_TIERS.md §5). A non-root user
# with sudo does not work there: gVisor does not raise privileges on exec of a setuid binary, and the node keeps
# no-new-privileges on (images/machine/smoke-test.sh shows both). `cloudana` (uid 1000) is the unprivileged account,
# reachable with the same key or with `su - cloudana`.
Port 22
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PermitRootLogin prohibit-password
AllowUsers root cloudana
# Root-owned key files written by the entrypoint from SSH_PUBLIC_KEY; ~/.ssh/authorized_keys still works too.
AuthorizedKeysFile /etc/ssh/authorized_keys/%u .ssh/authorized_keys
# No PAM: nothing to authenticate with but the key, and pam_loginuid needs a capability the box does not get.
UsePAM no
PermitUserEnvironment no
X11Forwarding no
PrintMotd no
